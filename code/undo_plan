undo:
    data structures:
        struct undo_step
        {
            u64 NthFrame;
            int NumTileRows;
            int NumTileCols;
            s32 *TileValues;
        };
        
        editor_state contains LastFrameUndoState:
            - LastFrameUndoState->TileValues lives in TransientStorage
            - At frame start, write the state of the pTileMap->TileValues array to LastFrameUndoState->TileValues
            - And write pTileMap->NumRows and NumCols to LastFrameUndoState->NumTileRows and NumTileCols

        static void
        WriteUndoState(const tile_map *pTileMap, undo_step *pWriteHere)
        {
            pWriteHere->NumTileRows = pTileMap->NumRows;
            pWriteHere->NumTileCols = pTileMap->NumCols;
            int NumBytesToCopy = pTileMap->NumRows * pTileMap->NumCols * sizeof(s32);
            memcpy(pWriteHere->TileValues, pTileMap->TileValues, NumBytesToCopy);
            pWriteHere->FrameNum = CurrentFrameNum;
        }

        static b32
        ShouldPushUndoStep(int HeadStateFrameNum, int CurrentStateFrameNum, undo_state LastFrameUndo, const tile_map *pTileMap)
        {
            if (CurrentStateFrameNum < HeadStateFrameNum) {
                return(false);
            }
            if (pTileMap->NumRows != LastFrameUndo.NumTileRows) {
                return(true);
            }
            if (pTileMap->NumCols != LastFrameUndo.NumTileCols) {
                return(true);
            }
            for (int TileIdx = 0; TileIdx < LastFrameUndo.NumTileRows * LastFrameUndo.NumTileCols; ++TileIdx) {
                if (pTileMap->TileValues[TileIdx] != LastFrameUndo.TileValues[TileIdx]) {
                    return(true);
                }
            }
            return(false);
        }

        static b32
        IsUndoRedoStepValid(int HeadIdx, int CurrIndex, int NewStep)
        {
            if(CurrIndex + NewStep == HeadIdx || CurrIdx + NewStep == HeadIdx+1) {
                    return(false);
            }
            else {
                return(true);
            }
        }


int 
GetCanonicalUndoIdx(int CurrIdx, int Step)
{
    // Passing a step further to the left of zero than
    //      the additive inverse of max undo steps is an error.
    // Realistically, we don't expect this function to be called 
    //      with step values that are not positive 1 or negative 1.
    Assert(Step >= -MAX_UNDO_STEPS);

    int Result = ((CurrIdx + Step) % MAX_UNDO_STEPS;
      // Mod takes sign of left operand, so if CurrIdx + step 
      //      evals to negative, we add max undo steps again to make it positive
      Result += MAX_UNDO_STEPS;
      // And lastly mod one more time to cover large positive step values.
      Result %= MAX_UNDO_STEPS;
}

Head points to most recent undo state that represents net-new changes.


